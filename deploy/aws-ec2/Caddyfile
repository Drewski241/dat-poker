# Public TLS front for DAT POKER. DAT_POKER_SITE comes from systemd env
# (apex, or "datpoker.com, www.datpoker.com"). ACME HTTP-01 uses :80 —
# nginx must be stopped so Caddy can bind it. Cloudflare records must be
# DNS only (grey cloud) so Let's Encrypt reaches this host.

{$DAT_POKER_SITE} {
  encode gzip

  handle /health* {
    reverse_proxy 127.0.0.1:4000
  }

  handle /v1/* {
    reverse_proxy 127.0.0.1:4000
  }

  handle {
    root * /usr/share/nginx/html
    try_files {path} /index.html
    file_server
  }
}
