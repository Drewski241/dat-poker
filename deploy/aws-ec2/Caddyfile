# Public TLS front for DAT POKER beta. DAT_POKER_DOMAIN comes from systemd env.
# ACME HTTP-01 uses :80 — nginx must be stopped so Caddy can bind it.

{$DAT_POKER_DOMAIN} {
  encode gzip

  handle /health* {
    reverse_proxy 127.0.0.1:4000
  }

  handle /v1/* {
    reverse_proxy 127.0.0.1:4000
  }

  handle {
    root * /usr/share/nginx/html
    try_files {path} /index.html
    file_server
  }
}
