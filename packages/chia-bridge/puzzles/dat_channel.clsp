; Inner puzzle of a DAT CAT for a two-player payment channel.
; CREATE_COIN puzzle hashes are inner hashes. The CAT layer wraps them.
;
; Curried: ALICE_PK BOB_PK TIMEOUT CHANNEL_NONCE UNROLL_MOD_HASH
; Solution: (mode sequence alice_ph alice_amt bob_ph bob_amt)
;   mode 0 — cooperative close (AGG_SIG_ME). sequence is ignored.
;   mode 1 — spend to an unroll coin of this state (AGG_SIG_UNSAFE).

(mod (
    ALICE_PK
    BOB_PK
    TIMEOUT
    CHANNEL_NONCE
    UNROLL_MOD_HASH
    mode
    sequence
    alice_ph
    alice_amt
    bob_ph
    bob_amt
  )

  (defun sha256tree (TREE)
    (if (l TREE)
      (sha256 2 (sha256tree (f TREE)) (sha256tree (r TREE)))
      (sha256 1 TREE)
    )
  )

  (defun atom-hash (ATOM)
    (sha256 1 ATOM)
  )

  (defun pair-hash (LEFT RIGHT)
    (sha256 2 LEFT RIGHT)
  )

  (defun nil-hash ()
    (sha256 1 ())
  )

  (defun quoted (ARG_HASH)
    (pair-hash (atom-hash 1) ARG_HASH)
  )

  ; Proper list [4, (1 . arg), rest] ending the chain at integer 1.
  (defun cons-arg (ARG_HASH REST_HASH)
    (pair-hash
      (atom-hash 4)
      (pair-hash
        (quoted ARG_HASH)
        (pair-hash REST_HASH (nil-hash))
      )
    )
  )

  (defun apply-hash (MOD_HASH ENV_HASH)
    (pair-hash
      (atom-hash 2)
      (pair-hash
        (quoted MOD_HASH)
        (pair-hash ENV_HASH (nil-hash))
      )
    )
  )

  (defun one-hash ()
    (atom-hash 1)
  )

  (defun curry10 (MOD A1 A2 A3 A4 A5 A6 A7 A8 A9 A10)
    (apply-hash MOD
      (cons-arg A1
        (cons-arg A2
          (cons-arg A3
            (cons-arg A4
              (cons-arg A5
                (cons-arg A6
                  (cons-arg A7
                    (cons-arg A8
                      (cons-arg A9
                        (cons-arg A10 (one-hash))
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )

  (defun state-hash (NONCE SEQ APH AAMT BPH BAMT)
    (sha256tree (list "DAT/1/state" NONCE SEQ APH AAMT BPH BAMT))
  )

  (defun close-hash (NONCE APH AAMT BPH BAMT)
    (sha256tree (list "DAT/1/close" NONCE APH AAMT BPH BAMT))
  )

  (defun total (AAMT BAMT)
    (if (any (> 0 AAMT) (> 0 BAMT))
      (x)
      (+ AAMT BAMT)
    )
  )

  (if (= mode 0)
    (c (list 50 ALICE_PK (close-hash CHANNEL_NONCE alice_ph alice_amt bob_ph bob_amt))
      (c (list 50 BOB_PK (close-hash CHANNEL_NONCE alice_ph alice_amt bob_ph bob_amt))
        (c (list 73 (total alice_amt bob_amt))
          (c (list 51 alice_ph alice_amt)
            (c (list 51 bob_ph bob_amt)
              ()
            )
          )
        )
      )
    )
    (if (= mode 1)
      (c (list 49 ALICE_PK (state-hash CHANNEL_NONCE sequence alice_ph alice_amt bob_ph bob_amt))
        (c (list 49 BOB_PK (state-hash CHANNEL_NONCE sequence alice_ph alice_amt bob_ph bob_amt))
          (c (list 73 (total alice_amt bob_amt))
            (c (list 51 (curry10
              UNROLL_MOD_HASH
              (atom-hash ALICE_PK)
              (atom-hash BOB_PK)
              (atom-hash TIMEOUT)
              (atom-hash CHANNEL_NONCE)
              (atom-hash sequence)
              (atom-hash alice_ph)
              (atom-hash alice_amt)
              (atom-hash bob_ph)
              (atom-hash bob_amt)
              (atom-hash UNROLL_MOD_HASH)
            ) (total alice_amt bob_amt))
              ()
            )
          )
        )
      )
      (x)
    )
  )
)
