# API
API_PORT=4000
API_HOST=0.0.0.0

# Realtime gateway
GATEWAY_PORT=4100
GATEWAY_HOST=0.0.0.0

# DAT Governance Token (Chia CAT) — required for buy-ins / cash games
# Mainnet asset_id from your wallet or block explorer (64 hex chars)
DAT_GOVERNANCE_TOKEN_ASSET_ID=
DAT_GOVERNANCE_TOKEN_TICKER=DAT
DAT_ALLOW_DEV_BUYIN=false
# Minimum buy-in in CAT mojos (1 DAT = 1000 mojos). 1000000 = 1000 DAT.
# Do NOT use XCH-scale values (e.g. 2000000000000).
DAT_MIN_BUY_IN_MOJOS=1000000
# 9-max SNG: house bots fill empty seats so one human can play the tournament flow.
DAT_SNG_FILL_HOUSE=true
# In-game faucet: 5000 DAT per UTC day (5000000 CAT mojos). Not an on-chain send.
DAT_DAILY_REDEEM_MOJOS=5000000

# Withdraw / cash-out (virtual buy-in pays net winnings by default)
# net = pay stack minus original buy-in (e.g. +50 DAT after 1000 buy-in → 1050 stack)
# full = pay entire table stack on-chain (when buy-in is escrowed on-chain)
DAT_WITHDRAW_PAYOUT_MODE=net
# Withdraw — AWS beta runs treasury on the website host (see docs/TREASURY.md)
# Dev / AWS same-host: http://127.0.0.1:4200/payout (or localhost)
# Split host later: http://TREASURY_HOST_PRIVATE_IP:4200/payout
DAT_TREASURY_PAYOUT_URL=http://localhost:4200/payout
# On when DAT_TREASURY_PAYOUT_URL is set. The site asks player Sage
# (chia_takeOffer) to Accept; copy-paste import is the fallback.
# Set false to force ledger-only.
# DAT_ENABLE_ONCHAIN_WITHDRAW=true
# Reject payouts to the treasury Sage address (use a separate player key).
# TREASURY_XCH_ADDRESS=
# Player chia_takeOffer fee. Sage Accept has no fee box — leave 0.
# Treasury pays the XCH fee on make_offer and on-chain cancel_offer (TREASURY_PAYOUT_FEE_MOJOS).
DAT_WITHDRAW_FEE_MOJOS=0

# --- Treasury process (AWS beta: same host as the website, bind 127.0.0.1) ---
TREASURY_PORT=4200
TREASURY_HOST=127.0.0.1
# mock = dev only. rpc = Sage make_offer (requires Sage RPC running).
TREASURY_OFFER_MODE=rpc
TREASURY_WALLET_BACKEND=sage
TREASURY_WALLET_RPC_URL=https://127.0.0.1:9257
# Treasury Sage fingerprint (set automatically after import)
TREASURY_SAGE_FINGERPRINT=
# Dedicated treasury spend key (hex/bech32 private key or 24-word mnemonic).
# This is NOT TREASURY_WALLET_KEY_PATH — wallet.key is only the RPC TLS cert.
# Prefer: sudo bash deploy/aws-ec2/load-treasury-key.sh
# TREASURY_SAGE_PRIVATE_KEY=
# TREASURY_SAGE_MNEMONIC=
# Treasury Sage XCH fee on make_offer and on-chain cancel (dust-storm floor).
# 9000000 mojos = 0.000009 XCH = ceil(100M cost × 0.09 mojo/cost).
# 0 or the old 1000000 default is raised to that floor.
TREASURY_PAYOUT_FEE_MOJOS=9000000
# Auto-detected on Linux: ~/.local/share/sage/ssl/wallet.{crt,key}
# TREASURY_WALLET_CERT_PATH=~/.local/share/sage/ssl/wallet.crt
# TREASURY_WALLET_KEY_PATH=~/.local/share/sage/ssl/wallet.key
TREASURY_WALLET_INSECURE=false

# Chia / chia-gaming integration
CHIA_NETWORK=mainnet
CHIA_CHAIN_ID=chia:mainnet
CHIA_GAMING_LOBBY_URL=http://localhost:3001
CHIA_GAMING_GAME_URL=http://localhost:3000
COINSET_URL=https://coinset.org
WALLETCONNECT_PROJECT_ID=

# Tester feedback (comments + screenshots). Default: ./data/feedback
# DAT_FEEDBACK_DIR=/opt/dat-poker/data/feedback
# Optional login HMAC secret. Set this so testers stay signed in across restarts.
# DAT_SESSION_SECRET=
# Player accounts (username/password). Default: ./data/accounts.json
# DAT_ACCOUNTS_PATH=/opt/dat-poker/data/accounts.json
# Transactional email (verification + password reset). memory = test outbox; log = stdout; smtp = send via SMTP.
# DAT_EMAIL_MODE=smtp
# Default without SMTP is log (codes in journalctl, not inboxes). Beta-only: DAT_EMAIL_BETA_REVEAL_CODE=true returns betaVerificationCode in auth JSON.
# DAT_EMAIL_FROM=DAT Poker <noreply@datspiritpoker.com>
# DAT_SMTP_HOST=
# DAT_SMTP_PORT=587
# DAT_SMTP_USER=
# DAT_SMTP_PASS=
# DAT_SMTP_SECURE=false
# Unseat seated humans with no polls/actions for this long (ms, min 10000). Default 120000.
# DAT_PLAYER_INACTIVE_UNSEAT_MS=120000

# Play eligibility (bot + jurisdiction) on register, login, email verify, and Sage session login
# DAT_PLAY_COMPLIANCE_MODE=required
# off = disable (local only). test = accept COMPLIANCE test token in auth tests.
# Cloudflare Turnstile (bot check) — use test keys in dev: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# DAT_TURNSTILE_SITE_KEY=
# DAT_TURNSTILE_SECRET=
# ISO country codes blocked from play (comma-separated). Defaults include CU, IR, KP, SY if unset.
# DAT_BLOCKED_COUNTRY_CODES=
# DAT_MIN_PLAYER_AGE=18

# Terms and Conditions (version bump forces re-acceptance; acceptance kept on file for N days)
# DAT_TERMS_VERSION=2026-09-17
# DAT_TERMS_EFFECTIVE_DATE=2026-09-17
# DAT_TERMS_ACCEPTANCE_DAYS=365
# DAT_TERMS_PATH=/opt/dat-poker/content/terms.md
# DAT_TERMS_ACCEPTANCE_PATH=/opt/dat-poker/data/terms-acceptances.json
# In-game DAT ledger (redeem + cash-out). Default: ./data/ledger.json
# DAT_LEDGER_PATH=/opt/dat-poker/data/ledger.json

# Postgres (future)
DATABASE_URL=postgres://dat_poker:dat_poker@localhost:5432/dat_poker

# Redis (future)
REDIS_URL=redis://localhost:6379
