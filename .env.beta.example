# API + web on the public beta host (no treasury keys on this machine)
API_PORT=4000
API_HOST=0.0.0.0
DAT_ALLOW_DEV_BUYIN=true
DAT_MIN_BUY_IN_MOJOS=1000000
DAT_DAILY_REDEEM_MOJOS=5000000
DAT_GOVERNANCE_TOKEN_TICKER=DAT
DAT_WITHDRAW_PAYOUT_MODE=net
DAT_TREASURY_PAYOUT_URL=
CHIA_NETWORK=mainnet
CHIA_CHAIN_ID=chia:mainnet
# Sage WalletConnect — set on the host with deploy/aws-ec2/enable-sage.sh
# Pairing needs HTTPS (deploy/aws-ec2/enable-https.sh). Keep treasury keys off this machine.
WALLETCONNECT_PROJECT_ID=
DAT_GOVERNANCE_TOKEN_ASSET_ID=
# Tester comments/screenshots on the game host (not published)
# DAT_FEEDBACK_DIR=/opt/dat-poker/data/feedback
# Optional login HMAC secret. Set this so testers stay signed in across restarts.
# DAT_SESSION_SECRET=
# Player accounts. Default: ./data/accounts.json
# DAT_ACCOUNTS_PATH=/opt/dat-poker/data/accounts.json
# Email (SES SMTP recommended). Links use your public site URL.
# DAT_PUBLIC_APP_URL=https://datspiritpoker.com
# DAT_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# DAT_SMTP_PORT=587
# DAT_SMTP_USER=
# DAT_SMTP_PASS=
# DAT_SMTP_FROM=DAT Poker <noreply@datspiritpoker.com>
# In-game DAT ledger. Default: ./data/ledger.json
# DAT_LEDGER_PATH=/opt/dat-poker/data/ledger.json
