# API + web + treasury HTTP on the public beta host.
API_PORT=4000
API_HOST=0.0.0.0
DAT_ALLOW_DEV_BUYIN=true
DAT_MIN_BUY_IN_MOJOS=1000000
DAT_DAILY_REDEEM_MOJOS=5000000
DAT_GOVERNANCE_TOKEN_TICKER=DAT
DAT_WITHDRAW_PAYOUT_MODE=net
DAT_TREASURY_PAYOUT_URL=http://127.0.0.1:4200/payout
DAT_ENABLE_ONCHAIN_WITHDRAW=true
# Player Accept has no fee box. Treasury pays the XCH fee on make_offer and cancel_offer.
DAT_WITHDRAW_FEE_MOJOS=0
TREASURY_PAYOUT_FEE_MOJOS=9000000
TREASURY_HOST=127.0.0.1
TREASURY_PORT=4200
CHIA_NETWORK=mainnet
CHIA_CHAIN_ID=chia:mainnet
# Sage WalletConnect — set on the host with deploy/aws-ec2/enable-sage.sh
# Pairing needs HTTPS (deploy/aws-ec2/enable-https.sh). Player Sage stays off this machine.
# Treasury Sage RPC on this host is required for real DAT offers.
# After sudo bash deploy/aws-ec2/enable-treasury-sage.sh:
# TREASURY_WALLET_CERT_PATH=/home/ec2-user/.local/share/sage/ssl/wallet.crt
# TREASURY_WALLET_KEY_PATH=/home/ec2-user/.local/share/sage/ssl/wallet.key
# TREASURY_SAGE_FINGERPRINT=
# Dedicated treasury spend key (not the player Sage, not wallet.key TLS cert):
# Load or replace: sudo bash deploy/aws-ec2/load-treasury-key.sh
# TREASURY_SAGE_PRIVATE_KEY=
# TREASURY_SAGE_MNEMONIC=
WALLETCONNECT_PROJECT_ID=
DAT_GOVERNANCE_TOKEN_ASSET_ID=
# Tester comments/screenshots on the game host (not published)
# DAT_FEEDBACK_DIR=/opt/dat-poker/data/feedback
# Optional login HMAC secret. Set this so testers stay signed in across restarts.
# DAT_SESSION_SECRET=
# Player accounts. Default: ./data/accounts.json
# DAT_ACCOUNTS_PATH=/opt/dat-poker/data/accounts.json
# In-game DAT ledger. Default: ./data/ledger.json
# DAT_LEDGER_PATH=/opt/dat-poker/data/ledger.json
